{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "spectrum-visualizer-overlay",
  "name": "Spectrum Visualizer Overlay",
  "version": "0.1.0",
  "minAndroidSdk": 26,
  "entryClass": "me.jxl.kiosk.plugins.spectrumvisualizer.SpectrumVisualizerPlugin",
  "description": "Winamp-style spectrum overlay for Kiosk Satellite screensavers and Fotoo, with animated or microphone FFT modes.",
  "author": "Local Kiosk Satellite project",
  "license": "MIT",
  "capabilities": [
    "overlay",
    "host.read"
  ],
  "settings": [
    {
      "key": "overlayTarget",
      "type": "select",
      "title": "Show on",
      "default": "Kiosk Satellite + Fotoo",
      "options": [
        "Kiosk Satellite + Fotoo",
        "Kiosk Satellite only",
        "Fotoo only"
      ],
      "group": "Visualizer",
      "description": "Choose which screensavers show the visualizer."
    },
    {
      "key": "source",
      "type": "select",
      "title": "Visualizer source",
      "default": "Animated",
      "options": [
        "Animated",
        "Microphone"
      ],
      "group": "Visualizer",
      "description": "Animated is decorative. Microphone performs a real FFT of room audio using Kiosk Satellite's microphone permission."
    },
    {
      "key": "mediaEntity",
      "type": "entity",
      "title": "Media player (optional)",
      "default": "",
      "group": "Visualizer",
      "description": "Optional media_player used to show the visualizer only while music is playing."
    },
    {
      "key": "showOnlyWhenPlaying",
      "type": "boolean",
      "title": "Only while playing",
      "default": true,
      "group": "Visualizer",
      "description": "When a media player is selected, hide the visualizer unless its state is playing."
    },
    {
      "key": "position",
      "type": "select",
      "title": "Position",
      "default": "Bottom",
      "options": [
        "Top",
        "Center",
        "Bottom"
      ],
      "group": "Layout",
      "description": "Vertical position of the spectrum."
    },
    {
      "key": "edgeOffset",
      "type": "number",
      "title": "Edge offset",
      "default": 24,
      "min": 0,
      "max": 300,
      "step": 1,
      "unit": "dp",
      "group": "Layout",
      "description": "Distance from the selected top or bottom edge."
    },
    {
      "key": "widthPercent",
      "type": "number",
      "title": "Width",
      "default": 70,
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "group": "Layout",
      "description": "Visualizer width as a percentage of screen width."
    },
    {
      "key": "heightDp",
      "type": "number",
      "title": "Height",
      "default": 110,
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "dp",
      "group": "Layout",
      "description": "Visualizer height."
    },
    {
      "key": "opacity",
      "type": "number",
      "title": "Opacity",
      "default": 85,
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "group": "Layout",
      "description": "Visualizer opacity."
    },
    {
      "key": "barCount",
      "type": "number",
      "title": "Spectrum bars",
      "default": 32,
      "min": 8,
      "max": 64,
      "step": 4,
      "group": "Spectrum",
      "description": "Number of frequency bands."
    },
    {
      "key": "fps",
      "type": "number",
      "title": "Refresh rate",
      "default": 20,
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "fps",
      "group": "Spectrum",
      "description": "Target redraw rate."
    },
    {
      "key": "gain",
      "type": "number",
      "title": "Microphone gain",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 1,
      "group": "Spectrum",
      "description": "Visual gain applied to microphone FFT levels."
    }
  ],
  "commands": [
    {
      "id": "show",
      "title": "Show visualizer now"
    },
    {
      "id": "test",
      "title": "Show visualizer test"
    },
    {
      "id": "hide",
      "title": "Hide visualizer"
    }
  ],
  "groups": [
    {
      "title": "Visualizer"
    },
    {
      "title": "Layout"
    },
    {
      "title": "Spectrum"
    }
  ]
}
